+def three_dev_fixture(tmp_path):
+    raw = protocol_fixture(tmp_path, cases=9, dev_count=3).model_dump(mode="json")
+    raw["train_seeds"] = [0, 1, 2]
+    return ResearchContract.model_validate(raw)
